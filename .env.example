# =============================================================================
# 1) Credenciais das APIs da Cedro (downstream) — solicite a comercial@cedrotech.com
# =============================================================================
# Usadas pelo ServiceAccountCredentialProvider (default atual).
CEDRO_USER=
CEDRO_PASS=

# Credenciais OAuth2 do módulo de Notícias (POST /connect/token)
CEDRO_NEWS_CLIENT_ID=
CEDRO_NEWS_CLIENT_SECRET=

# Credenciais de Market Data Socket e Trading (OMS) — contas SEPARADAS da REST acima (nunca a
# mesma: REST e Socket já são mutuamente exclusivas por login). Só usadas por
# ServiceAccountCredentialProvider (dev/stdio); em produção via MCP_WEB_LOGIN, cada usuário traz
# as próprias no formulário de /cedro-login. Streaming está na Fase 2 e Trading na Fase 1 do
# roadmap "Cedro Connect IA".
CEDRO_CRYSTAL_USER=
CEDRO_CRYSTAL_PASSWORD=
# Socket Crystal usa host/porta TCP; a software key pode ficar vazia.
CEDRO_CRYSTAL_HOST=
CEDRO_CRYSTAL_PORT=81
CEDRO_CRYSTAL_SOFTWARE_KEY=
CEDRO_TRADING_USER=
CEDRO_TRADING_PASS=
# Alternativa explícita para Trading quando o SignIn e a identidade OMS são distintos.
# Se ausentes, o provider usa CEDRO_TRADING_USER/PASS (modo legado) e, com CEDRO_OMS_* abaixo,
# pode cair de volta em CEDRO_USER/PASS para o SignIn.
CEDRO_TRADING_SIGNIN_USER=
CEDRO_TRADING_SIGNIN_PASS=
CEDRO_OMS_ACCOUNT=
CEDRO_OMS_LOGIN=
CEDRO_OMS_PASSWORD=

# Host do Trading, SE diferente de CEDRO_BASE_URL — achado real (21/09): uma credencial de
# certificação (https://wfcertificacao.cedrotech.com) contra produção (webfeeder) dá 401 vazio
# no brokerServiceLogin, sem nenhum dos padrões documentados (code 3/24). Deixe em branco se sua
# credencial de Trading é do mesmo ambiente (produção) que a Market Data REST.
CEDRO_TRADING_BASE_URL=

# Guardrails do preview de ordem. Teto de valor (qty × preço) por ordem: acima dele o preview é
# RECUSADO (0 = sem teto). Banda de preço: alerta quando o preço está mais que X% longe do último
# negócio da Market Data (0 = desligado).
CEDRO_TRADING_MAX_ORDER_VALUE=0
CEDRO_TRADING_PRICE_BAND_PCT=10

CEDRO_BASE_URL=https://webfeeder.cedrotech.com
CEDRO_HTTP_TIMEOUT=15

# Socket Crystal é TCP/Telnet, não WebSocket. A porta padrão é 81.
CEDRO_STREAM_SNAPSHOT_TIMEOUT=5
CEDRO_STREAM_TAPE_LIMIT=1000

# Caminho da documentação exposta como resources cedro-docs:// — a skill pública
# market-data-rest (repo irmão), NUNCA o vault interno. Deixe em branco para usar o default
# (../cedro-api-skills/cedro-api-skills/skills/market-data-rest).
CEDRO_DOCS_PATH=

# =============================================================================
# 2) Auth do CHAMADOR — IAM da Cedro (Identity Server) + API key
# =============================================================================
# A auth só é ATIVADA quando CEDRO_IAM_ISSUER e MCP_RESOURCE_URL estão definidos.
# Sem elas, o servidor sobe SEM autenticação (use apenas em dev local via stdio).
CEDRO_IAM_ISSUER=https://sso-sandbox.cedrotech.com
CEDRO_IAM_JWKS_URL=https://sso-sandbox.cedrotech.com/.well-known/openid-configuration/jwks
CEDRO_IAM_AUDIENCE=

# API keys para automação. Formato: <key>:<subject>:<escopos separados por |>  (registros com ;)
# Ex.: CEDRO_API_KEYS=k_abc:robo-cotacoes:marketdata:read;k_xyz:robo:marketdata:read|marketdata:news
CEDRO_API_KEYS=

# =============================================================================
# 3) Transporte MCP (Streamable HTTP)
# =============================================================================
MCP_TRANSPORT=streamable-http     # ou "stdio" para desenvolvimento local
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# URL pública deste MCP (identificador do resource server no OAuth). Obrigatória p/ ativar a auth.
MCP_RESOURCE_URL=http://localhost:8000/mcp

# Login pelo navegador — quando true, o próprio MCP vira a autoridade OAuth: em vez de validar
# um JWT do IAM (acima), mostra uma página própria (/cedro-login) pedindo login/senha da Market
# Data REST, verifica contra o SignIn real, e emite um token pro cliente MCP. Ver
# docs/arquitetura/06-credential-transport.md. Mutuamente exclusivo com CEDRO_IAM_ISSUER na
# prática — quando true, ignora o IAM e usa sempre este fluxo.
MCP_WEB_LOGIN=false

# ⚠️ Sem CEDRO_IAM_ISSUER + MCP_RESOURCE_URL, rodando em transporte NÃO-stdio (streamable-http)
# o servidor agora RECUSA subir (evita expor as 26 tools sem autenticação por acidente).
# Só defina isto como "true" se quiser mesmo rodar sem auth em HTTP (ex.: demo local).
MCP_ALLOW_UNAUTHENTICATED_HTTP=false

# =============================================================================
# 4) Segurança do transporte
# =============================================================================
# ⚠️ IMPORTANTE: o FastMCP só liga a proteção anti-DNS-rebinding sozinho quando MCP_HOST é local.
# Servindo em 0.0.0.0 (container/LB), ela fica DESLIGADA a menos que você preencha abaixo.
# Listas separadas por vírgula. Aceita curinga de porta: "mcp.cedrotech.com:*"
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Rate limit por token (0 = desligado). Estado em memória, POR PROCESSO.
MCP_RATE_LIMIT=0
MCP_RATE_WINDOW=60

# Nível de log (DEBUG, INFO, WARNING, ERROR). Em INFO, cedro_mcp.tools loga cada chamada de tool
# e cedro_mcp.audit os eventos de Trading (preview/confirm) — nunca argumentos nem tokens.
MCP_LOG_LEVEL=INFO

# =============================================================================
# 4) Estado compartilhado, métricas e cota
# =============================================================================
# Redis para rate limit, tokens de confirmação de Trading, login pelo navegador e cota. Vazio =
# memória do processo (restart desloga todo mundo; com N réplicas cada uma tem o próprio estado).
# Ex.: redis://redis:6379/0  (rediss:// para TLS)
MCP_REDIS_URL=
# Obrigatório com MCP_REDIS_URL: cifra as credenciais do login pelo navegador antes de irem ao
# Redis. String longa e aleatória (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))").
# Trocar este valor desloga todo mundo.
MCP_STORE_SECRET=

# Bearer exigido em /metrics (Prometheus). Vazio = /metrics desligado (404).
MCP_METRICS_TOKEN=

# Cota mensal de chamadas de tool por plano (UTC, zera no dia 1º). Vazio = sem cota.
# O plano vem do escopo plan:<nome> do token (IAM ou API key); sem ele, vale MCP_DEFAULT_PLAN.
# Ex.: MCP_PLAN_QUOTAS=basico:20000,pro:100000,enterprise:500000
MCP_PLAN_QUOTAS=
MCP_DEFAULT_PLAN=
